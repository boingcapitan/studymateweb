PORT=3000
# URL del frontend (para CORS). En local: http://localhost:5173
FRONTEND_URL=http://localhost:5173
# URL pública del backend (para generar el enlace iCal)
PUBLIC_API_URL=http://localhost:3000

SUPABASE_URL=https://xxxx.supabase.co
# ¡SECRETA! nunca en el frontend
SUPABASE_SERVICE_ROLE_KEY=eyJ...

GEMINI_API_KEY=AIza...
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# JSON completo de la cuenta de servicio de Firebase, en UNA sola línea
FIREBASE_SERVICE_ACCOUNT={"type":"service_account"}

# Cadena larga aleatoria para proteger /api/cron/reminders
CRON_SECRET=cambia-esto-por-algo-largo-y-aleatorio
